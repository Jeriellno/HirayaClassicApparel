# ===========================================================================
# IDM-VTON service — environment configuration.
#
# Copy this file to `.env` (which is gitignored) and adjust it for the host.
#   cp .env.example .env
#
# NO machine-specific path is hard-coded anywhere in the code; every value the
# service reads comes from here (or from the process environment). The service
# loads `.env` at startup via python-dotenv.
# ===========================================================================

# ---------------------------------------------------------------------------
# MODEL_PATH
# ---------------------------------------------------------------------------
# Where the IDM-VTON model weights live.
#
# EITHER a HuggingFace repo id (recommended):
#   MODEL_PATH=yisol/IDM-VTON
# ...in which case `diffusers`/`transformers` download and cache the weights
# from the Hub on first run (requires network + huggingface_hub).
#
# OR an absolute/relative path to a LOCAL directory previously downloaded with
# `huggingface-cli download yisol/IDM-VTON --local-dir ./models/IDM-VTON`:
#   MODEL_PATH=./models/IDM-VTON
MODEL_PATH=yisol/IDM-VTON

# ---------------------------------------------------------------------------
# CKPT_DIR
# ---------------------------------------------------------------------------
# Directory holding the NON-IDM-VTON checkpoints the pipeline needs to build
# the agnostic inpainting mask and the DensePose conditioning image:
#
#   CKPT_DIR/
#   |-- humanparsing/
#   |   |-- parsing_atr.onnx
#   |   |-- parsing_lip.onnx
#   |-- openpose/
#   |   |-- ckpts/
#   |       |-- body_pose_model.pth
#   |-- densepose/
#       |-- model_final_162be9.pkl
#
# These are the exact locations the official gradio_demo/app.py reads. See
# README.md for the upstream download links.
CKPT_DIR=./models/ckpt

# ---------------------------------------------------------------------------
# DEVICE
# ---------------------------------------------------------------------------
# `auto`  -> cuda:0 when CUDA is available, otherwise cpu.
# `cuda:0`, `cuda:1`, ... -> pin a specific GPU.
# `cpu`   -> CPU ONLY. This is NOT PRACTICAL for IDM-VTON: the model is SDXL
#            fp16 and its preprocessing modules call torch.cuda.set_device(),
#            so real inference will not work correctly on CPU. The service
#            reports this honestly through /health instead of pretending.
DEVICE=auto

# ---------------------------------------------------------------------------
# UPLOAD_DIR / OUTPUT_DIR
# ---------------------------------------------------------------------------
# Scratch space for the two inbound images and the generated render. Both are
# created automatically. Temporary inputs are deleted after each request;
# outputs are kept and served read-only from /results/<file>.
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs

# Retention for generated results. A background sweeper deletes files older
# than this many minutes so an unattended GPU host does not fill its disk.
# Set to 0 to disable the sweeper (results are then never auto-deleted).
OUTPUT_RETENTION_MINUTES=1440

# ---------------------------------------------------------------------------
# HOST / PORT
# ---------------------------------------------------------------------------
# Bind address of the FastAPI server. Defaults to loopback on purpose: exposing
# this directly to the public internet is discouraged. Put it behind an HTTPS
# reverse proxy (or a VPN / firewall allow-list) and keep the bearer token on.
HOST=127.0.0.1
PORT=8000

# ---------------------------------------------------------------------------
# IDM_VTON_API_KEY
# ---------------------------------------------------------------------------
# Optional server-to-server bearer token. When set, EVERY request to
# /virtual-tryon must carry `Authorization: Bearer <token>`.
#
# Leave EMPTY for a local-only loopback deployment (development). ALWAYS set it
# when the service is reachable over a network. The token is consumed only by
# the PHP backend (Hiraya) and must NEVER be shipped to browser JavaScript.
IDM_VTON_API_KEY=

# ---------------------------------------------------------------------------
# Inference defaults
# ---------------------------------------------------------------------------
# Applied when the caller omits the field. IDM-VTON's own demo uses 30 steps
# and seed 42; the pipeline itself was released at guidance_scale 2.0.
DEFAULT_DENOISE_STEPS=30
DEFAULT_SEED=42
GUIDANCE_SCALE=2.0

# Fallback garment description used when the caller sends an empty
# `garment_description`. IDM-VTON feeds this into the garment text encoder, so
# a neutral description is safer than an empty string. See README.md — for best
# results the caller should send the real product name/description.
DEFAULT_GARMENT_DESCRIPTION="a stylish garment"

# Maximum accepted upload size per image, in bytes. Both the person and the
# garment image are bounded by this.
MAX_IMAGE_BYTES=12000000

# ---------------------------------------------------------------------------
# Image resolution
# ---------------------------------------------------------------------------
# IDM-VTON was trained and released at 768x1024. Changing these without a
# matching fine-tune degrades the render; they are exposed only so the values
# are visible/configurable rather than buried in the code.
IMAGE_WIDTH=768
IMAGE_HEIGHT=1024
