APP_NAME=Hiraya
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS is UNIX-ONLY and does NOTHING on Windows.
#
# `php artisan serve` is SINGLE-THREADED: it handles ONE request at a time, so
# the requests a page fires together (the admin dashboard mounts /products +
# /admin/orders + /admin/analytics/* + /system-status at once) QUEUE behind each
# other. Measured here: 4 concurrent calls = 9.7s wall clock for only ~3.4s of
# real work, and the last one tripped the client's 15s timeout with
# "The Hiraya server took too long to respond."
#
# PHP's built-in server only forks workers via `pcntl`, which does not exist on
# Windows — verified on this box: with PHP_CLI_SERVER_WORKERS=4 set, the Windows
# PHP 8.3 ZTS binary still started ONE process. So this line is left commented
# for Unix devs and cannot help a Windows dev; see HIRAYA_SYSTEM_FLOW.md for the
# Windows options (Octane/Swoole, or serve through nginx+fpm).
# PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==========================================
# SUPABASE POSTGRESQL DATABASE CONFIG
# ==========================================
# Use the SESSION pooler host (port 5432) for Laravel. The transaction
# pooler (6543) does not support prepared statements the way the ORM uses them.
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.qnyskltxjfdsvncaehvh
DB_PASSWORD=
DB_SSLMODE=require
# Every table is tbl_<name>; see config/database.php and `php artisan hiraya:prefix-tables`.
DB_PREFIX=tbl_

# Seconds libpq waits for the pooler handshake before aborting. Without this a
# cold/sleeping Supabase pooler hangs the request and the single-threaded dev
# server (`php artisan serve`) stops answering every other request too.
DB_CONNECT_TIMEOUT=5
# Reuse one DB connection per PHP process (see config/database.php).
DB_PERSISTENT=true
# DB_URL=  # Optional: a single postgres:// URL overrides the fields above.

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# `public` — product/catalog uploads are served over HTTP from `/storage/...`.
# Leaving this as `local` writes to storage/app/private, which the web server
# cannot serve, so any code that omits an explicit disk produced dead URLs.
FILESYSTEM_DISK=public
# VIRTUAL TRY-ON QUEUE.
#
# `database` puts the try-on render on the `tryon` queue, which REQUIRES a running
# worker or every session stays `queued` forever (the Studio shows
# "no worker is draining the queue", code: worker_offline):
#
#   php artisan queue:work --queue=tryon,default
#
# `sync` renders inline and needs no worker, but ONLY on a multi-process server
# (nginx + php-fpm / Octane): the built-in single-threaded `php artisan serve`
# enforces a ~60s request ceiling that a ~90-155s render exceeds, so an inline
# render dies with "Maximum execution time of 60 seconds exceeded".
QUEUE_CONNECTION=database

# CA bundle for ALL outbound HTTPS (Gemini + Supabase).
# On Windows PHP, curl.cainfo is usually empty, so cURL has no trust store and
# every TLS call dies with "cURL error 60: unable to get local issuer
# certificate". Pointing this at a real bundle fixes Gemini image analysis AND
# the Supabase uploads/deletes at once, with no php.ini edit. Leave blank to use
# the system default.
HTTP_CA_BUNDLE=storage/certs/cacert.pem
# Gemini Vision is used to suggest garment catalog details from uploaded images.
# This model returns TEXT only — it can never return an image.
GEMINI_API_KEY=
#
# THE KEY POOL — the cure for "drained by noon".
# Each key carries its OWN 20/day free bucket. A key that answers 429 sits out
# the rest of the day and the NEXT key answers automatically (rotation state
# lives in the cache, shared by web and worker). Add more free keys from
# https://aistudio.google.com/apikey, comma-separated:
#
#   GEMINI_API_KEYS=key2,key3
#   1 key = 20/day · 2 keys = 40/day · 3 keys = 60/day, all automatic.
#
# Leave BLANK to keep the old single-key behaviour (nothing breaks).
GEMINI_API_KEYS=
# MUST be a model the key can actually reach. MEASURED against the live API
# with THIS key, right now:
#
#   gemini-2.0-flash        -> 404 "no longer available" (retired)
#   gemini-2.5-flash        -> 429 quota (free tier: limit 20/day)
#   gemini-2.5-flash-lite   -> 404 "no longer available to new users"
#   gemini-3-flash          -> 404 not found for v1beta/generateContent
#   gemini-3.5-flash-lite   -> 200 OK   <- USE THIS
#   gemini-3.5-flash        -> 200 OK   (same tier, larger)
#
# Google retires model IDs for NEW users without breaking old ones, so a name
# that worked in an earlier session can 404 here. gemini-3.5-flash-lite is the
# current free-tier vision model confirmed working with this key. It also has
# its OWN 20/day quota bucket, separate from the exhausted 2.5 one — a stopgap,
# not the cure; see PERSON_VERIFY_PROVIDERS below for the real fix.
GEMINI_VISION_MODEL=gemini-2.5-flash
#
# FALLBACK CHAIN for the VISION model — tried in order when the model above
# fails (429 quota, 404 retired, an outage). Comma-separated. This is what keeps
# the 20/day wall of ONE model from refusing a legitimate customer: when the
# first bucket is empty the next model answers. Leave blank for no fallback.
GEMINI_VISION_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash
#
# ==========================================
# PERSON-VERIFICATION VISION PROVIDERS (CHAIN)
# ==========================================
# The "is there a real person in this photo?" gate on /tryon/verify-person.
# Comma-separated, tried left to right; the first provider that ANSWERS wins.
# Gemini is first; a fallback is only reached when Gemini is genuinely
# unavailable (quota 429, outage), never when it answered "no person".
#
# PERSON VERIFY PROVIDERS — tried LEFT TO RIGHT, first usable answer wins.
#
# WHY THIS IS A CHAIN AND NOT JUST `gemini`:
#   The Gemini free tier answers only **20 requests PER DAY** for vision, and that
#   bucket is SHARED with the catalog auto-fill. When it drains, every legitimate
#   customer upload is refused with "could not be verified right now" — measured
#   in this deployment's own log:
#       Quota exceeded for metric: generate_content_free_tier_requests, limit: 20
#   A single provider is therefore a single point of failure for the whole
#   try-on feature. Adding a second provider makes a drained Gemini bucket a
#   non-event: the chain moves on instead of refusing.
#
# ORDER MATTERS. Gemini is first because it is already configured and already
# carries the stricter prompt tuning. A fallback is reached ONLY when Gemini
# could not ANSWER at all (quota 429, outage, retired model 404, malformed reply)
# — NEVER when Gemini answered a confident "no person". That keeps the verdict
# stable: adding fallbacks cannot make the gate more permissive, only more
# available.
#
# PROVIDERS WITHOUT A KEY ARE SKIPPED AUTOMATICALLY, so listing one here costs
# nothing until its credential is set below.
#
# RECOMMENDED NEXT STEP: create a Cloudflare Workers AI token (free, no card)
# and paste it into CLOUDFLARE_ACCOUNT_ID + CLOUDFLARE_API_TOKEN below. Its daily
# neuron budget is far larger than 20 requests, which removes the wall entirely.
PERSON_VERIFY_PROVIDERS=gemini,cloudflare,groq
#
# CLOUDFLARE WORKERS AI — recommended FREE fallback (daily neuron budget far
# above 20 requests/day). Needs an account id + a "Workers AI" API token.
#
# SETUP (free, no credit card):
#   1. https://dash.cloudflare.com -> copy the ACCOUNT ID (right sidebar).
#   2. My Profile -> API Tokens -> Create Token -> custom token with the
#      "Workers AI" permission (Account.Workers AI:Read).
#   3. Paste both below. The provider activates on the next request — no code
#      change, because it is already listed in PERSON_VERIFY_PROVIDERS above.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
#
# GROQ — fast free tier, OpenAI-compatible vision API.
GROQ_API_KEY=
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
#
# OPENAI — paid "last resort"; only used when a key is present.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
# Image-OUTPUT model for the virtual try-on render, tried FIRST.
# Image generation is a SEPARATE capability from the text models, so the vision
# model above cannot be used here. Free-tier image quota is limited (HTTP 429).
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Fallback chain, tried in order after GEMINI_IMAGE_MODEL. Comma-separated.
GEMINI_IMAGE_MODELS=gemini-2.5-flash-image,gemini-3.1-flash-image,gemini-3.1-flash-lite-image
# Try-on render engine: auto | gemini | replicate
#
# NO LONGER SELECTS ANYTHING. ProcessTryOnJob::callVtonApi() calls the dedicated
# VTON API (PixelAPI) and NOTHING ELSE — Gemini, Replicate, Hugging Face and the
# local browser composite were all removed from the chain on purpose. This value
# is kept only for parity with the legacy (uncalled) callVtonApiChain().
TRYON_PROVIDER=auto
# ==========================================
# VIRTUAL TRY-ON RENDER ENGINE (PIXELAPI)
# ==========================================
# THIS is where the try-on API key goes — NOT in ProcessTryOnJob.php or any
# other PHP file. The job hands the session to App\Services\VtonApiRenderer,
# which reads its endpoint + token from config('services.vton.*'), which in turn
# reads these variables. Nothing downstream works without them.
#
# Paste your PixelAPI key into VTON_API_TOKEN below. Grab it from your PixelAPI
# dashboard (https://pixelapi.dev). The renderer sends it as an
# `Authorization: Bearer <token>` header.
#
# WITHOUT a token: VtonApiRenderer::render() returns `not_configured`, the
# session FAILS with that reason, and the Studio shows a failed fitting. That
# is deliberate — there is no mock/placeholder fallback any more.
VTON_API_URL=https://api.pixelapi.dev/v1/virtual-tryon
VTON_API_TOKEN=

# FLAT vs WRAPPER PAYLOAD — THIS ONE MATTERS.
#   VTON_MODEL_NAME empty  -> FLAT body   (PixelAPI): { person_image, garment_image, category }
#   VTON_MODEL_NAME set    -> WRAPPER body (FASHN):  { model_name, inputs: { ... } }
# PixelAPI is a flat API, so this MUST stay empty. Leaving the code default
# ('tryon-v1.6') here would wrap the request in a FASHN envelope and PixelAPI
# would reject it.
VTON_MODEL_NAME=

# Async polling endpoint. `{id}` is replaced with the job id from the submit
# response. NOTE: the config default is FASHN's, so this MUST be overridden.
VTON_STATUS_URL=https://api.pixelapi.dev/v1/virtual-tryon/jobs/{id}

# Request field names (these already match PixelAPI's contract).
VTON_PERSON_FIELD=person_image
VTON_GARMENT_FIELD=garment_image
VTON_CATEGORY_FIELD=category
# Category vocabulary — PixelAPI's LIVE accepted set, read from its own 422
# validation error: "category must be upperbody, lowerbody, dress, saree,
# lehenga, kurti, or sherwani". This is NOT the upper_body/lower_body/full_body
# spelling on the older tutorial page, which is wrong.
VTON_CATEGORY_TOP=upperbody
VTON_CATEGORY_BOTTOM=lowerbody
VTON_CATEGORY_DRESS=dress
# Response paths. BOTH are left EMPTY on purpose — empty means "walk the
# documented shapes automatically" (see VtonApiRenderer::extractJobId /
# extractImage, which try the configured path first and then fall back through
# id | job_id | prediction_id | data.id and the known image shapes).
#
# WHY EMPTY IS SAFER THAN A PINNED VALUE: a completed PixelAPI job carries its
# render at `output_url` (MEASURED — `output` and `result_image_b64` were both
# null), and the submit response's job-id key was never probed. Pinning a wrong
# key here would break the poll silently; leaving it empty lets the walker find
# it. Pin a value only once you have seen the real response body.
VTON_JOB_ID_PATH=
VTON_IMAGE_PATH=

# QUALITY KNOBS — optional, omitted from the payload when unset (leave blank
# to keep the vendor defaults).
#   VTON_N_STEPS   : diffusion steps, PixelAPI default 20, higher = sharper
#   VTON_N_SAMPLES : candidate images to generate, default 1, max 4
VTON_N_STEPS=
VTON_N_SAMPLES=

# ==========================================
# VIRTUAL TRY-ON RENDER ENGINE — FASHN (PRIMARY SLOT)
# ==========================================
# FASHN is the PRIORITY provider. It renders FIRST whenever it has a token, and
# PixelAPI (above) catches it automatically if a FASHN render fails.
#
# THE SWITCH IS THE TOKEN. Nothing else:
#
#   VTON_FASHN_API_TOKEN empty  -> this slot is SKIPPED and PixelAPI renders
#                                  (this is the CURRENT state — behaviour is
#                                  identical to before FASHN was added)
#
#   VTON_FASHN_API_TOKEN set    -> FASHN becomes PRIMARY
#
# After pasting a key below, run:
#     php artisan config:clear && php artisan config:cache
# No code change is needed — the chain reads this value.
#
# Get a key from https://fashn.ai (dashboard -> API). The renderer sends it as an
# `Authorization: Bearer <token>` header.
#
# WHY THE VTON_FASHN_* PREFIX IS MANDATORY: these variables must NEVER share a
# namespace with the PixelAPI block above. The two vendors use DIFFERENT category
# words (FASHN: tops|bottoms|one-pieces / PixelAPI: upperbody|lowerbody|dress),
# and `env('KEY', $default)` falls back to the default when a key is absent OR
# empty. Reusing a name would silently feed one vendor the other's vocabulary —
# an HTTP 422 on every render, with the error message pointing at the photos
# instead of the payload.
#
# COMMENTED OUT BY DEFAULT: leaving these uncommented with empty values is safe
# (see the fallback note above), but the whole block is disabled so the defaults
# in config/services.php are the single source of truth until you deliberately
# opt in.

# POST https://api.fashn.ai/v1/run  -> { id }, then poll the status endpoint.

#fashn ai
VTON_FASHN_API_URL=https://api.fashn.ai/v1/run
VTON_FASHN_API_TOKEN=

# Wrapper-style model id. `tryon-v1.6` is FASHN's current try-on model. This MUST
# stay non-empty: a non-empty model_name is what tells the renderer to wrap the
# arguments in `{ model_name, inputs: {...} }` (the FASHN shape, as opposed to
# PixelAPI's flat body).
# VTON_FASHN_MODEL_NAME=tryon-v1.6

# Async polling endpoint; `{id}` is replaced with the job id.
# VTON_FASHN_STATUS_URL=https://api.fashn.ai/v1/status/{id}

# Request field names. NOTE `model_image`, not PixelAPI's `person_image`.
# VTON_FASHN_PERSON_FIELD=model_image
# VTON_FASHN_GARMENT_FIELD=garment_image
# VTON_FASHN_CATEGORY_FIELD=category

# Category vocabulary — FASHN'S OWN enum. These MUST NOT be PixelAPI's
# upperbody/lowerbody/dress words; FASHN rejects them with a 422.
# VTON_FASHN_CATEGORY_TOP=tops
# VTON_FASHN_CATEGORY_BOTTOM=bottoms
# VTON_FASHN_CATEGORY_DRESS=one-pieces

# Response paths. Empty = walk the documented shapes automatically.
# VTON_FASHN_JOB_ID_PATH=id
# VTON_FASHN_IMAGE_PATH=

# QUALITY KNOBS — optional, omitted from the payload when blank.
# VTON_FASHN_N_STEPS=
# VTON_FASHN_N_SAMPLES=

# ==========================================
# HUGGING FACE — FREE VTON TIER (optional, tried LAST)
# ==========================================
# The yisol/IDM-VTON Space is driven over its plain HTTP Gradio API
# (/upload -> /gradio_api/call/tryon -> SSE result stream) by
# App\Services\HuggingFaceVtonRenderer. It renders for FREE, so the job tries
# it before the paid PixelAPI engine.
#
# LICENSING — NOT COMMERCIAL: IDM-VTON is CC BY-NC-SA 4.0. Free of CHARGE is
# not free of LICENCE. Use this tier for development/demos/academic work; a
# commercial storefront must render through PixelAPI. Do not remove this caveat
# when going to production.
#
# The token is optional (anonymous calls work) but lifts the ZeroGPU quota and
# authenticates against private Spaces.
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_VTON_SPACE=yisol/IDM-VTON
# Optional explicit base url. Empty = derived from the Space id:
#   yisol/IDM-VTON -> https://yisol-idm-vton.hf.space
HUGGINGFACE_VTON_BASE=
# Gradio route prefix, set by the Space's gradio version. MEASURED on
# yisol/IDM-VTON: it runs Gradio 4.24.0, mounted at the root, so this stays
# EMPTY (/upload, /call/tryon). A Space on Gradio 4.44+/5.x needs /gradio_api.
HUGGINGFACE_VTON_API_PREFIX=
# The /tryon fn's remaining inputs (Space defaults):
#   garment description prompt, auto-mask (model mask), auto-crop (torso crop),
#   denoise steps (quality), seed (-1 = Space picks)
HUGGINGFACE_VTON_PROMPT="a photo of a person wearing the garment"
HUGGINGFACE_VTON_AUTO_MASK=true
HUGGINGFACE_VTON_AUTO_CROP=false
HUGGINGFACE_VTON_DENOISE_STEPS=30
HUGGINGFACE_VTON_SEED=-1

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=hirayaclassicapparel@gmail.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=starttls
MAIL_TIMEOUT=15
MAIL_FROM_ADDRESS=hirayaclassicapparel@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

FRONTEND_URL=https://hirayaclassicapparel-1.onrender.com

# ==========================================
# SUPABASE STORAGE (public asset buckets)
# ==========================================
# Origin of the Supabase project that holds the public `products` and
# `backgrounds` buckets. Consumed by App\Http\Controllers\SupabaseStorageController,
# which serves those objects through /supabase-storage/* so they stay SAME-ORIGIN.
#
# WHY THAT MATTERS: the SPA document carries `Cross-Origin-Embedder-Policy:
# require-corp` (public/.htaccess — required for onnxruntime-web's SharedArrayBuffer,
# worth ~6s vs ~22s per person mask). Supabase sends no Cross-Origin-Resource-Policy
# on a plain image request, so a direct <img src="https://<ref>.supabase.co/..."> is
# blocked with net::ERR_BLOCKED_BY_RESPONSE.NotSameOriginAfterDefaultedToSameOriginByCoep
# and every catalog image disappears. Proxying through this origin is what fixes it.
#
# DEPLOYMENT: point this at the same project the front-end's VITE_SUPABASE_URL uses,
# and make sure the built SPA's web server forwards /supabase-storage/ to index.php —
# see the Alias block in public/.htaccess. Leave it unset and the proxy answers 503
# with a logged warning rather than silently serving nothing.
SUPABASE_URL=https://qnyskltxjfdsvncaehvh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

VITE_APP_NAME="${APP_NAME}"

PASSWORD_RESET_SECRET=
# Secondary HF token (moved from stray root .txt, 2026-09-27) - swap into HUGGINGFACE_API_TOKEN if the primary dies
HUGGINGFACE_API_TOKEN_BACKUP=
