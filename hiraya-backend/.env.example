APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS is UNIX-ONLY; it is a no-op on Windows (the built-in
# server needs `pcntl` to fork workers, which Windows PHP lacks — verified:
# Windows PHP 8.3 ZTS still started a single process with =4 set).
# On Unix it makes `php artisan serve` serve concurrent requests in parallel
# instead of queueing them one at a time; uncomment it there if a page's
# parallel API calls are tripping the client timeout.
# PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==========================================
# SUPABASE POSTGRESQL DATABASE CONFIG
# ==========================================
# Use the SESSION pooler host (port 5432) for Laravel. The transaction
# pooler (6543) does not support prepared statements the way the ORM uses them.
DB_CONNECTION=pgsql
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=
DB_SSLMODE=require
# Seconds libpq waits for the pooler handshake before aborting. Without this a
# cold/sleeping Supabase pooler hangs the request and the single-threaded dev
# server (`php artisan serve`) stops answering every other request too.
DB_CONNECT_TIMEOUT=10
# DB_URL=  # Optional: a single postgres:// URL overrides the fields above.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# `public` — product/catalog uploads are served over HTTP from `/storage/...`.
# Leaving this as `local` writes to storage/app/private, which the web server
# cannot serve, so any code that omits an explicit disk produced dead URLs.
FILESYSTEM_DISK=public
# VIRTUAL TRY-ON QUEUE.
#
# `database` puts the try-on render on the `tryon` queue, which REQUIRES a running
# worker or every session stays `queued` forever (the Studio shows
# "no worker is draining the queue", code: worker_offline):
#
#   php artisan queue:work --queue=tryon,default
#
# `sync` renders inline and needs no worker, but ONLY on a multi-process server
# (nginx + php-fpm / Octane): the built-in single-threaded `php artisan serve`
# enforces a ~60s request ceiling that a ~90-155s render exceeds, so an inline
# render dies with "Maximum execution time of 60 seconds exceeded".
QUEUE_CONNECTION=database

# CA bundle for ALL outbound HTTPS (Gemini + Supabase).
# On Windows PHP, curl.cainfo is usually empty, so cURL has no trust store and
# every TLS call dies with "cURL error 60: unable to get local issuer
# certificate". Point this at a real bundle (a copy ships at
# storage/certs/cacert.pem) to fix it without touching php.ini. Blank = system default.
HTTP_CA_BUNDLE=storage/certs/cacert.pem
# Gemini Vision is used to suggest garment catalog details from uploaded images.
# This model returns TEXT only — it can never return an image.
GEMINI_API_KEY=
# OPTIONAL key pool: comma-separated additional keys, each with its OWN 20/day
# free bucket. A key that answers 429 sits out the day; the next key answers
# automatically. Leave blank for single-key behaviour.
GEMINI_API_KEYS=
# `gemini-2.0-flash` is RETIRED and 404s; use the current stable vision model.
GEMINI_VISION_MODEL=gemini-2.5-flash
# ==========================================
# PERSON-VERIFICATION VISION PROVIDERS (CHAIN)
# ==========================================
# The "is there a real person in this photo?" gate on /tryon/verify-person.
# Gemini's FREE tier answers only 20 requests/DAY, shared with the catalog
# auto-fill; caching stretches that budget but does not remove the wall. So the
# endpoint walks an ORDERED list and uses the FIRST provider that answers.
#
# Comma-separated, tried left to right. Gemini should stay FIRST (already set up).
# A provider with NO key is SKIPPED, so listing one costs nothing until you set
# its credential. Leave BLANK to keep the old single-Gemini behaviour.
PERSON_VERIFY_PROVIDERS=gemini
#
# CLOUDFLARE WORKERS AI — the recommended FREE fallback (daily neuron budget that
# dwarfs 20 requests). Needs an account id + a "Workers AI" API token.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
#
# GROQ — a fast free tier for the same vision task (OpenAI-compatible API).
GROQ_API_KEY=
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
#
# OPENAI — the paid "last resort"; only used when a key is present.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
# Image-OUTPUT model for the virtual try-on render, tried FIRST.
# Image generation is a SEPARATE capability from the text models, so the vision
# model above cannot be used here. Free-tier image quota is limited (HTTP 429).
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Fallback chain, tried in order after GEMINI_IMAGE_MODEL. Comma-separated.
GEMINI_IMAGE_MODELS=gemini-2.5-flash-image,gemini-3.1-flash-image,gemini-3.1-flash-lite-image,gemini-2.5-flash-image-preview,gemini-2.0-flash-preview-image-generation
# Try-on render engine: auto | gemini | replicate
#
# NO LONGER SELECTS ANYTHING. ProcessTryOnJob::callVtonApi() calls the dedicated
# VTON API (PixelAPI) and NOTHING ELSE — Gemini, Replicate, Hugging Face and the
# local browser composite were all removed from the chain on purpose. Kept for
# parity with the legacy (uncalled) callVtonApiChain().
TRYON_PROVIDER=auto
# ==========================================
# VIRTUAL TRY-ON RENDER ENGINE (PIXELAPI)
# ==========================================
# The try-on API key goes HERE — never in a PHP file. ProcessTryOnJob hands the
# session to App\Services\VtonApiRenderer, which reads its endpoint + token from
# config('services.vton.*'), which reads these variables.
#
# WITHOUT VTON_API_TOKEN: render() returns `not_configured` and the session
# FAILS. There is no mock/placeholder fallback — a labelled drawing was removed
# because it was never an honest substitute for a real try-on.
VTON_API_URL=https://api.pixelapi.dev/v1/virtual-tryon
VTON_API_TOKEN=pk_live_59592eebfaa875e9bf6a480472423dfbd302797cd36eec16

# FLAT vs WRAPPER PAYLOAD — THIS ONE MATTERS.
#   VTON_MODEL_NAME empty -> FLAT body   (PixelAPI): { person_image, garment_image, category }
#   VTON_MODEL_NAME set   -> WRAPPER body (FASHN):  { model_name, inputs: { ... } }
# PixelAPI is flat, so this MUST stay empty — the code default is FASHN's
# 'tryon-v1.6', which would wrap the request in a FASHN envelope and be rejected.
VTON_MODEL_NAME=

# Async polling endpoint; `{id}` is replaced with the job id. The config default
# is FASHN's, so this MUST be overridden for PixelAPI.
VTON_STATUS_URL=https://api.pixelapi.dev/v1/virtual-tryon/jobs/{id}

# Request field names.
VTON_PERSON_FIELD=person_image
VTON_GARMENT_FIELD=garment_image
VTON_CATEGORY_FIELD=category
# Category vocabulary — PixelAPI's LIVE accepted set (read from its own 422),
# NOT the upper_body/lower_body/full_body spelling on the older tutorial page.
VTON_CATEGORY_TOP=upperbody
VTON_CATEGORY_BOTTOM=lowerbody
VTON_CATEGORY_DRESS=dress
# Response paths. BOTH empty on purpose — empty means "walk the documented
# shapes automatically". A completed PixelAPI job carries the render at
# `output_url` (measured); the walker finds it without a pinned path. Pin a
# value only once you have seen the real response body.
VTON_JOB_ID_PATH=
VTON_IMAGE_PATH=

# Quality knobs — omitted from the payload when blank (vendor defaults apply).
VTON_N_STEPS=
VTON_N_SAMPLES=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==========================================
# MAIL — SMTP for password reset delivery
# ==========================================
#
# Password reset is the one feature that CANNOT work without a real mail sender:
# there is no way to hand a locked-out customer a link other than by email.
#
# HOW TO CONFIGURE (pick one provider):
#
#   Gmail / Google Workspace
#     MAIL_HOST=smtp.gmail.com
#     MAIL_PORT=587
#     MAIL_USERNAME=you@gmail.com
#     MAIL_PASSWORD=your-16-char-app-password     <-- App Password, NOT your login
#     MAIL_FROM_ADDRESS=you@gmail.com
#
#   Outlook / Microsoft 365
#     MAIL_HOST=smtp.office365.com
#     MAIL_PORT=587
#     MAIL_USERNAME=you@yourdomain.com
#     MAIL_PASSWORD=your-password
#     MAIL_FROM_ADDRESS=you@yourdomain.com
#
#   Brevo / SendGrid / Mailgun (recommended for production volume)
#     MAIL_HOST=smtp-relay.brevo.com  (or smtp.sendgrid.net)
#     MAIL_PORT=587
#     MAIL_USERNAME=<provider username>
#     MAIL_PASSWORD=<provider SMTP key>
#
# NOTES
#   - MAIL_ENCRYPTION is optional: it is DERIVED from the port (465 = TLS,
#     anything else = STARTTLS) so getting the port right is enough.
#   - Gmail and Outlook both REQUIRE MAIL_FROM_ADDRESS to match MAIL_USERNAME, or
#     they silently rewrite the sender. A mismatched From is the most common
#     reason reset mail lands in spam.
#   - Leaving MAIL_HOST empty falls back to the `log` mailer: mail is written to
#     storage/logs/laravel.log instead of sent, which keeps the reset endpoint
#     working (and the link recoverable) during local setup with no credentials.
#   - Reset links point at FRONTEND_URL. Set it to your real frontend origin or
#     the emailed link will send customers to the wrong host.

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_TIMEOUT=15
MAIL_FROM_ADDRESS="no-reply@hiraya.local"
MAIL_FROM_NAME="${APP_NAME}"

# Origin used to build the password-reset link emailed to customers.
FRONTEND_URL=http://localhost:5173

# Optional dedicated secret for signing reset tokens. When empty, APP_KEY is
# used. Set it in production so rotating APP_KEY does not invalidate every
# in-flight reset link.
PASSWORD_RESET_SECRET=

# ==========================================
# SUPABASE STORAGE (public asset buckets)
# ==========================================
# Origin of the Supabase project that holds the public `products` and
# `backgrounds` buckets. Consumed by App\Http\Controllers\SupabaseStorageController,
# which serves those objects through /supabase-storage/* so they stay SAME-ORIGIN.
#
# WHY THAT MATTERS: the SPA document carries `Cross-Origin-Embedder-Policy:
# require-corp` (public/.htaccess — required for onnxruntime-web's SharedArrayBuffer,
# worth ~6s vs ~22s per person mask). Supabase sends no Cross-Origin-Resource-Policy
# on a plain image request, so a direct <img src="https://<ref>.supabase.co/..."> is
# blocked with net::ERR_BLOCKED_BY_RESPONSE.NotSameOriginAfterDefaultedToSameOriginByCoep
# and every catalog image disappears. Proxying through this origin is what fixes it.
#
# DEPLOYMENT: point this at the same project the front-end's VITE_SUPABASE_URL uses,
# and make sure the built SPA's web server forwards /supabase-storage/ to index.php —
# see the Alias block in public/.htaccess. Leave it unset and the proxy answers 503
# with a logged warning rather than silently serving nothing.
SUPABASE_URL=

VITE_APP_NAME="${APP_NAME}"
