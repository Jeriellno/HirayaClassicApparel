# Copy this file to `.env` and fill in real values.
# Vite only reads env files from THIS directory (hiraya-frontend/).

# Backend API endpoint (Laravel). Without it, src/api/axios.js falls back to
# the hardcoded http://127.0.0.1:8000/api, which breaks non-local deploys.
VITE_API_BASE_URL=http://localhost:8000/api

# Supabase project used by the SuperAdmin console + maintenance mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
